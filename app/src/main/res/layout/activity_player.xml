<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="live feed / بث مباشر"
        android:textColor="#FFFFFF"
        android:padding="6dp"
        android:layout_margin="8dp" />

    <TextView
        android:id="@+id/playerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تم ارسال هذا البث في توقيت"
        android:textColor="#FFFFFF"
        android:padding="4dp"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/playerViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عدد المشاهدات 0"
        android:textColor="#FFFFFF"
        android:padding="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/custom_player_control"
        app:use_controller="true"
        app:resize_mode="fit" />

</LinearLayout>
